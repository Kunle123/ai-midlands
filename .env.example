# ChatGPT Ads Measurement Pixel ID from Ads Manager > Conversions.
# This is a public browser-side identifier, not an API key.
VITE_OPENAI_ADS_PIXEL_ID=

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=

# Set to true temporarily while testing tracking in the browser console.
VITE_TRACKING_DEBUG=false
